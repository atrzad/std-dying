{
  "name": "std-dying",
  "version": "2.0.0",
  "private": true,
  "description": "std(dying): painel de estudos que une os cofres do Obsidian (Dev, Carreira, ENEM, Manaus Previdência e BB), com caderno de notas e caneta, cronograma semanal, revisões espaçadas e IA.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "senha": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/scripts/senha.js",
    "fontes": "node server/scripts/copiar-fontes.js",
    "gerar-dev": "node server/scripts/gerar-trilha-dev.js",
    "gerar-carreira": "node server/scripts/gerar-trilha-carreira.js",
    "importar-sketchbook": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/scripts/importar-sketchbook.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "express": "^5.2.1",
    "markdown-it": "^14.3.2",
    "nodemailer": "^10.0.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/jacquard-24": "^5.3.0",
    "@fontsource/jacquarda-bastarda-9": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0"
  }
}
