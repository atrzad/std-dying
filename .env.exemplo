# std(dying) — produção nesta máquina
PORTA=3300
# O Node só escuta em localhost; o acesso de fora chega pelo container Tailscale de deploy/tailscale,
# que faz o HTTPS e repassa para cá.
HOST=127.0.0.1
DATA_DIR=~/.local/share/std-dying
# Endereço público aceito no cabeçalho Host (o resto recebe 421).
HOSTS_EXTRAS=std-dying.tail9ff58.ts.net
# Confia no X-Forwarded-For/Proto só do proxy local (Tailscale): IP real no limite de login e cookie Secure no HTTPS.
TRUST_PROXY=true
# Endereço usado nos links enviados por e-mail e no redirecionamento dos endereços antigos.
URL_PUBLICA=https://std-dying.tail9ff58.ts.net

# Caderno do dono: a pasta que o Obsidian abre (as trilhas ficam dentro dela).
COFRE_DONO=~/Documents/Ayo Sketchbook

# Endereços antigos, só para redirecionar até 14/11/2026 (deploy/tailscale-antigos/):
# os do Ayo Std mantêm o caminho e a sessão; os do Ayo Sketchbook levam à mesma nota no Caderno.
ENDERECOS_ANTIGOS=ayo-std.tail9ff58.ts.net
ENDERECOS_ANTIGOS_CADERNO=ayo-sketchbook.tail9ff58.ts.net

# E-mail de confirmação (SMTP). Em branco = o link vai para o log do serviço.
# SMTP_HOST=
# SMTP_PORTA=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_DE=

# IA da página /ia (Claude, da Anthropic). Sem a chave, a integração fica desligada e a página só monta o prompt.
# Modelo, esforço de cada modo, perfis com acesso, limite diário e orçamento mensal: config/ia.json.
# ANTHROPIC_API_KEY=sk-ant-...
